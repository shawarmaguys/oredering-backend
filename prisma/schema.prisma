generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String          @id @default(uuid()) @db.Uuid
  fullName               String          @map("full_name")
  email                  String          @unique
  passwordHash           String          @map("password_hash")
  role                   UserRole        @default(WORKER)
  isActive               Boolean         @default(true) @map("is_active")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")
  approvedPurchaseOrders PurchaseOrder[] @relation("PurchaseOrderApprover")
  userLocations          UserLocation[]

  @@map("users")
}

model Location {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String               @unique
  address             String
  createdAt           DateTime             @default(now()) @map("created_at")
  email               String
  phone               String
  slackBotToken       String?              @map("slack_bot_token")
  slackUserToken      String?              @map("slack_user_token")
  locationDepartments LocationDepartment[]
  locationItems       LocationItem[]
  purchaseOrders      PurchaseOrder[]
  schedules           Schedule[]
  stockRecords        StockRecord[]
  userLocations       UserLocation[]

  @@map("locations")
}

model UserLocation {
  userId     String   @map("user_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, locationId])
  @@map("user_locations")
}

model Department {
  id                  String               @id @default(uuid()) @db.Uuid
  code                String
  fullName            String               @map("full_name")
  slackChannel        String?              @map("slack_channel")
  isActive            Boolean              @default(true) @map("is_active")
  locationDepartments LocationDepartment[]
  vendors             Vendor[]

  @@map("departments")
}

model LocationDepartment {
  locationId   String     @map("location_id") @db.Uuid
  departmentId String     @map("department_id") @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  location     Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([locationId, departmentId])
  @@map("location_departments")
}

model Vendor {
  id             String          @id @default(uuid()) @db.Uuid
  displayName    String          @map("display_name")
  channelName    String?         @map("channel_name")
  email          String?
  address1       String?
  address2       String?
  address3       String?
  phone          String?
  departmentId   String          @map("department_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at")
  isActive       Boolean         @default(true) @map("is_active")
  items          Item[]
  purchaseOrders PurchaseOrder[]
  schedules      Schedule[]
  department     Department      @relation(fields: [departmentId], references: [id])

  @@map("vendors")
}

model ProductType {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  color       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  items       Item[]

  @@map("product_types")
}

model Item {
  id                 String              @id @default(uuid()) @db.Uuid
  vendorId           String              @map("vendor_id") @db.Uuid
  productTypeId      String?             @map("product_type_id") @db.Uuid
  displayName        String              @map("display_name")
  baseUnitName       String              @map("base_unit_name")
  displayUnitName    String?             @map("display_unit_name")
  multiplier         Decimal?            @db.Decimal(10, 4)
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  productCode        String?             @map("product_code")
  note               String?
  spanishName        String?             @map("spanish_name")
  vendor             Vendor              @relation(fields: [vendorId], references: [id])
  productType        ProductType?        @relation(fields: [productTypeId], references: [id], onDelete: SetNull)
  locationItems      LocationItem[]
  purchaseOrderItems PurchaseOrderItem[]
  stockRecordItems   StockRecordItem[]

  @@map("items")
}

model LocationItem {
  id           String   @id @default(uuid()) @db.Uuid
  locationId   String   @map("location_id") @db.Uuid
  itemId       String   @map("item_id") @db.Uuid
  parLevel     Decimal  @default(0) @map("par_level") @db.Decimal(10, 4)
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  item         Item     @relation(fields: [itemId], references: [id])
  location     Location @relation(fields: [locationId], references: [id])

  @@unique([locationId, itemId])
  @@map("location_items")
}

model StockRecord {
  id                     String            @id @default(uuid()) @db.Uuid
  locationId             String            @map("location_id") @db.Uuid
  submittedBy            String?           @map("submitted_by")
  slackMessageTs         String?           @map("slack_message_ts")
  submittedAt            DateTime          @default(now()) @map("submitted_at")
  approvedAt             DateTime?         @map("approved_at")
  isCompleted            Boolean           @default(true) @map("is_completed")
  responseSlackMessageTs String?           @map("response_slack_message_ts")
  purchaseOrders         PurchaseOrder[]
  items                  StockRecordItem[]
  location               Location          @relation(fields: [locationId], references: [id])

  @@map("stock_records")
}

model StockRecordItem {
  id                     String      @id @default(uuid()) @db.Uuid
  stockRecordId          String      @map("stock_record_id") @db.Uuid
  itemId                 String      @map("item_id") @db.Uuid
  createdAt              DateTime    @default(now()) @map("created_at")
  basicQuantity          Decimal     @default(0) @map("basic_quantity") @db.Decimal(10, 4)
  secondaryQuantity      Decimal     @default(0) @map("secondary_quantity") @db.Decimal(10, 4)
  frontBasicQuantity     Decimal     @default(0) @map("front_basic_quantity") @db.Decimal(10, 4)
  frontSecondaryQuantity Decimal     @default(0) @map("front_secondary_quantity") @db.Decimal(10, 4)
  item                   Item        @relation(fields: [itemId], references: [id])
  stockRecord            StockRecord @relation(fields: [stockRecordId], references: [id], onDelete: Cascade)

  @@map("stock_record_items")
}

model PurchaseOrder {
  id             String              @id @default(uuid()) @db.Uuid
  vendorId       String              @map("vendor_id") @db.Uuid
  locationId     String              @map("location_id") @db.Uuid
  stockRecordId  String?             @map("stock_record_id") @db.Uuid
  createdBy      String              @map("created_by")
  approvedBy     String?             @map("approved_by") @db.Uuid
  status         PurchaseOrderStatus @default(DRAFT)
  pdfUrl         String?             @map("pdf_url")
  slackMessageTs String?             @map("slack_message_ts")
  notes          String?
  createdAt      DateTime            @default(now()) @map("created_at")
  approvedAt     DateTime?           @map("approved_at")
  emailsSent     String?             @map("emails_sent")
  items          PurchaseOrderItem[]
  approver       User?               @relation("PurchaseOrderApprover", fields: [approvedBy], references: [id])
  location       Location            @relation(fields: [locationId], references: [id])
  stockRecord    StockRecord?        @relation(fields: [stockRecordId], references: [id])
  vendor         Vendor              @relation(fields: [vendorId], references: [id])

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                 String        @id @default(uuid()) @db.Uuid
  purchaseOrderId    String        @map("purchase_order_id") @db.Uuid
  itemId             String        @map("item_id") @db.Uuid
  quantity           Decimal       @db.Decimal(10, 4)
  unitName           String        @map("unit_name")
  createdAt          DateTime      @default(now()) @map("created_at")
  basicQuantity      Decimal?      @map("basic_quantity") @db.Decimal(10, 4)
  normalizedQuantity Decimal?      @map("normalized_quantity") @db.Decimal(10, 4)
  parLevel           Decimal?      @map("par_level") @db.Decimal(10, 4)
  secondaryQuantity  Decimal?      @map("secondary_quantity") @db.Decimal(10, 4)
  suggestedQuantity  Decimal?      @map("suggested_quantity") @db.Decimal(10, 4)
  item               Item          @relation(fields: [itemId], references: [id])
  purchaseOrder      PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@map("purchase_order_items")
}

model Schedule {
  id           String       @id @default(uuid()) @db.Uuid
  locationId   String       @map("location_id") @db.Uuid
  vendorId     String       @map("vendor_id") @db.Uuid
  scheduleType ScheduleType @map("schedule_type")
  dayOfWeek    Int?         @map("day_of_week")
  triggerTime  String       @map("trigger_time")
  slackChannel String?      @map("slack_channel")
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  location     Location     @relation(fields: [locationId], references: [id])
  vendor       Vendor       @relation(fields: [vendorId], references: [id])

  @@map("schedules")
}

model Translation {
  id             String @id @default(uuid()) @db.Uuid
  sourceText     String @map("source_text")
  translatedText String @map("translated_text")
  sourceLanguage String @map("source_language")
  targetLanguage String @map("target_language")

  @@map("translations")
}

enum UserRole {
  WORKER
  MANAGER
  ADMIN
  SUPER_MANAGER
}

enum PurchaseOrderStatus {
  DRAFT
  GENERATED
  SENT
  ACKNOWLEDGED
  CANCELLED
}

enum ScheduleType {
  DAILY
  WEEKLY
}
